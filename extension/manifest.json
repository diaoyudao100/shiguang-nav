{
  "manifest_version": 3,
  "name": "拾光导航 · 一键收藏",
  "version": "1.0.0",
  "description": "把当前网页一键收藏到拾光导航：自动带标题，服务端补全图标与 AI 简述。点扩展图标或按 Alt+S 即可。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "contextMenus", "storage", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "host_permissions": ["https://shiguang-nav.diaoyudao110.workers.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "添加到拾光导航"
  },
  "options_page": "options.html",
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "收藏当前页面到拾光导航"
    }
  }
}
