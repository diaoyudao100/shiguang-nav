{
  "name": "personal-nav",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx scripts/test-bookmarks.mts",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf:db:init": "wrangler d1 execute shiguang-nav --remote -f schema.sql",
    "cf:db:init:local": "wrangler d1 execute shiguang-nav --local -f schema.sql",
    "ext:pack": "powershell -NoProfile -Command \"Compress-Archive -Path 'extension/*' -DestinationPath 'shiguang-nav-extension.zip' -Force\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "wrangler": "^4.127.1"
  }
}
